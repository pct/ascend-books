<li data-book data-search="<%= h(([book.title, book.author] + book.tags).join(" ").downcase) %>">
  <a href="<%= book.url %>" class="shelf-row">
    <% if c = book.cover %>
    <img src="<%= h(c) %>" alt="" width="48" height="70" loading="lazy" decoding="async" class="cover-img w-12 shrink-0">
    <% else %>
    <span class="cover-img cover-blank w-12" aria-hidden="true"><%= h(book.title.chars.first(2).join) %></span>
    <% end %>
    <span class="min-w-0">
      <span class="block text-lg font-bold leading-snug"><%= h(book.title) %></span>
      <span class="block text-sm text-base-content/65"><%= h(book.author) %><% if y = book.year %>，<%= y %><% end %></span>
      <span class="mt-1 line-clamp-2 block text-[15px] leading-relaxed text-base-content/80"><%= h(book.description) %></span>
    </span>
    <time datetime="<%= book.date_iso %>" class="text-xs text-base-content/55"><%= book.date_human %></time>
  </a>
</li>
