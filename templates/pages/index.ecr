<% if latest = books.first? %>
<section class="border-b border-base-300">
  <div class="mx-auto grid max-w-5xl items-start gap-8 px-5 py-12 sm:grid-cols-[auto_auto_1fr] sm:gap-12 sm:px-8 sm:py-16">
    <a href="<%= latest.url %>" class="block w-40 sm:w-52" aria-label="《<%= h(latest.title) %>》">
      <% if c = latest.cover %>
      <img src="<%= h(c) %>" alt="" width="208" height="305" decoding="async" class="cover-img cover-hero w-full">
      <% else %>
      <span class="cover-img cover-blank cover-hero w-full text-2xl" aria-hidden="true"><%= h(latest.title.chars.first(4).join) %></span>
      <% end %>
    </a>
    <h1 class="spine"><a href="<%= latest.url %>"><%= h(latest.title) %></a></h1>
    <div class="max-w-md sm:self-center sm:pt-2">
      <p class="quote"><%= h(latest.description) %></p>
      <p class="mt-6 text-base-content/70">
        <%= h(latest.author) %><% if p = latest.publisher %><br><%= h(p) %><% if y = latest.year %>，<%= y %><% end %><% end %>
      </p>
      <p class="mt-4 text-sm text-base-content/60"><time datetime="<%= latest.date_iso %>"><%= latest.date_human %></time></p>
      <a href="<%= latest.url %>" class="read-link mt-8">讀這篇心得</a>
    </div>
  </div>
</section>
<% end %>

<% if books.size != 1 %>
<section class="mx-auto max-w-5xl px-5 py-10 sm:px-8 sm:py-14" id="shelf">
  <% if books.empty? %>
  <h1 class="text-2xl font-bold">書架還是空的</h1>
  <p class="mt-3 text-base-content/70">執行 <code class="rounded bg-base-200 px-1.5 py-0.5 text-sm">ascend new "書名"</code> 開始第一篇。</p>
  <% else %>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="text-2xl font-bold">書架</h2>
    <% if books.size > 3 %>
    <input id="q" type="search" class="input input-sm w-44" placeholder="搜書名、作者、標籤" autocomplete="off" aria-label="搜尋">
    <% end %>
  </div>
  <ol class="mt-6 border-t border-base-300">
    <% books.each do |book| %>
    <%= book_row(book) %>
    <% end %>
  </ol>
  <p id="empty" class="hidden py-12 text-base-content/60">沒有符合的書。</p>
  <% if books.size > 3 %>
  <script>
  (() => {
    const q = document.getElementById('q');
    const cards = Array.from(document.querySelectorAll('[data-book]'));
    const empty = document.getElementById('empty');
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const ok = !term || c.dataset.search.includes(term);
        c.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      empty.classList.toggle('hidden', shown > 0);
    };
    q.addEventListener('input', apply);
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { q.value = initial; apply(); }
  })();
  </script>
  <% end %>
  <% end %>
</section>
<% end %>
